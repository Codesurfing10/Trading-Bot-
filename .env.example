# ──────────────────────────────────────────────────────────
# Schwab API credentials
# Register your app at https://developer.schwab.com
# ──────────────────────────────────────────────────────────
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Redirect URI registered in your Schwab app (must match exactly)
SCHWAB_REDIRECT_URI=https://127.0.0.1

# Encrypted account hash returned by GET /trader/v1/accounts
# (run `python -m bot.main --list-accounts` after authentication)
SCHWAB_ACCOUNT_HASH=your_account_hash_here

# Path to persist OAuth tokens between bot restarts
SCHWAB_TOKENS_FILE=tokens.json

# ──────────────────────────────────────────────────────────
# Bot behaviour
# ──────────────────────────────────────────────────────────
# Set to true to log intended orders without placing real trades
DRY_RUN=true

# Seconds between each polling cycle
POLL_INTERVAL_SECONDS=300

# Path to JSON file that persists open positions across restarts
STATE_FILE=state.json

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────
# Scanner (optional overrides)
# ──────────────────────────────────────────────────────────
# SCANNER_URL=https://codesurfing10.github.io/Trade-Scanner-2/stocks.json
# SCANNER_TIMEOUT=30

# ──────────────────────────────────────────────────────────
# Risk / trading parameters (optional overrides)
# ──────────────────────────────────────────────────────────
# MAX_POSITIONS=2
# BLOCK_SIZE=1000.0
# STOP_LOSS_PCT=2.5
# MAX_HOLD_DAYS=5
# RSI_OVERBOUGHT=70.0
